<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="20dp">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Source row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/amountText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="0"
                    android:textStyle="bold"
                    android:textColor="#1F1B24"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="@array/amount_text_sizes" />

                <TextView
                    android:id="@+id/sourceCurrencyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/currency_pill_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="EUR ▾"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#5B21B6" />
            </LinearLayout>

            <!-- Divider -->
            <TextView
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#ECE7F5"
                android:text="" />

            <!-- Target row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="0.00"
                    android:textStyle="bold"
                    android:textColor="#7C3AED"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="@array/amount_text_sizes" />

                <TextView
                    android:id="@+id/targetCurrencyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/currency_pill_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="USD ▾"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#5B21B6" />
            </LinearLayout>
        </LinearLayout>

        <!-- Swap button -->
        <TextView
            android:id="@+id/swapButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:background="@drawable/swap_button_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingBottom="4dp"
            android:text="↑↓"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </FrameLayout>

    <!-- Keypad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/key1" style="@style/KeypadKey" android:text="1"/>
            <TextView android:id="@+id/key2" style="@style/KeypadKey" android:text="2"/>
            <TextView android:id="@+id/key3" style="@style/KeypadKey" android:text="3"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/key4" style="@style/KeypadKey" android:text="4"/>
            <TextView android:id="@+id/key5" style="@style/KeypadKey" android:text="5"/>
            <TextView android:id="@+id/key6" style="@style/KeypadKey" android:text="6"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/key7" style="@style/KeypadKey" android:text="7"/>
            <TextView android:id="@+id/key8" style="@style/KeypadKey" android:text="8"/>
            <TextView android:id="@+id/key9" style="@style/KeypadKey" android:text="9"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/keyDot"
                style="@style/KeypadKey"
                android:text="."/>
            <TextView
                android:id="@+id/key0"
                style="@style/KeypadKey"
                android:text="0"/>
            <TextView
                android:id="@+id/keyClearAll"
                style="@style/KeypadKey"
                android:text="C"
                android:textColor="#7C3AED" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>